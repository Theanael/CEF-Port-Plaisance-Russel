<!DOCTYPE html>
<html>
    <head>
        <title>Liste des Catways</title>
        <link rel='stylesheet' href='/css/style.css' />
    </head>
    <body>
    
        <h2>Liste des Catways</h2>
        <table>
            <thead>
                <tr>
                    <th>Numéro</th>
                    <th>Type</th>
                    <th>Etat</th>
                </tr>
            </thead>
            <tbody>
                <% catways.forEach(catway => { %>
                    <%- include('line',{catway}) %>
                <% }) %>
                <tr>
                    <td>
                        <a href="./create">Créer un catway</a>
                    </td>
            </tr>
            </tbody>
                
        </table>
    </body>
  </html>