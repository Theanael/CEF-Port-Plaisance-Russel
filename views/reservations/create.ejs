<!DOCTYPE html>
<html>
    <head>
        <title>Nouvelle Réservation</title>
        <link rel='stylesheet' href='/css/style.css' />
    </head>
    <body>
        <form action="./add" method="POST">

            <label for="clientName">Client : </label>
            <input type="text" name="clientName" id="clientName"><br>
            <label for="boatName">Bateau : </label>
            <input type="text" name="boatName" id="boatName"><br>
            <span>Catway : <%= catway.catwayNumber %></span><br>
            <span>Période : </span>
            <label for="startDate">Du :</label>
            <input type="datetime-local" name="startDate" id="startDate">
            <label for="endDate">Au :</label>
            <input type="datetime-local" name="endDate" id="endDate"><br>
            <input type="submit" value="Créer">
            
        </form>
    </body>
  </html>