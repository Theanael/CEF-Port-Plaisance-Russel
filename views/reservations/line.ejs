<tr>
    <td>
        <%= reservation.clientName %>
    </td>
    <td>
        <%= reservation.boatName %>
    </td>
    <% if (withCatwayNumer) { %>
     <td><%= reservation.catwayNumber %></td>
    <% } %>
    <td>
        <%= reservation.startDate.toLocaleString() %>
    </td>
    <td>
        <%= reservation.endDate.toLocaleString() %>
    </td>
    <% if (withActions) { %>
      <td>
        <a href="reservations/<%= reservation._id %>/page">Modifier</a>
    </td>
    <td>
        <a href="reservations/<%= reservation._id %>/delete">Supprimer</a>
    </td>
    <% } %>
   
   
</tr>