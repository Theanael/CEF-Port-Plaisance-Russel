<!DOCTYPE html>
<html>
    <head>
        <title>Réservation</title>
        <link rel='stylesheet' href='/css/style.css' />
    </head>
    <body>
        <header>
            <h1>Port de Plaisance Russel</h1>
            <a href="/catways/<%= catway._id %>/page">Retour</a>
        </header>
        <main>
            <form action="/catways/<%= catway._id %>/reservations/<%= reservation._id %>" method="POST">
                <div>
                    <label for="clientName">Client : </label>
                    <input type="text" name="clientName" id="clientName" value="<%= reservation.clientName %>">
                </div>
                <div>
                    <label for="boatName">Bateau : </label>
                    <input type="text" name="boatName" id="boatName" value="<%= reservation.boatName %>">
                </div>
                <div>
                    <span>Catway :</span>
                    <span>
                        <%= reservation.catwayNumber %>
                    </span>
                </div>
                <div>
                    <span>Période : </span>
                    <span>
                        <label for="startDate">Du :</label>
                        <input type="datetime-local" name="startDate" id="startDate" 
                        value="<%= new Date(reservation.startDate).getFullYear() %>-<%= String(new Date(reservation.startDate).getMonth() + 1).padStart(2, '0') %>-<%= String(new Date(reservation.startDate).getDate()).padStart(2, '0') %>T<%= String(new Date(reservation.startDate).getHours()).padStart(2, '0') %>:<%= String(new Date(reservation.startDate).getMinutes()).padStart(2, '0') %>"
                        >
                    </span>
                    <span>
                        <label for="endDate">Au :</label>
                        <input type="datetime-local" name="endDate" id="endDate"
                        value="<%= new Date(reservation.endDate).getFullYear() %>-<%= String(new Date(reservation.endDate).getMonth() + 1).padStart(2, '0') %>-<%= String(new Date(reservation.endDate).getDate()).padStart(2, '0') %>T<%= String(new Date(reservation.endDate).getHours()).padStart(2, '0') %>:<%= String(new Date(reservation.endDate).getMinutes()).padStart(2, '0') %>"
                        >
                    </span>
                </div>
                <input type="submit" value="Modifier">
                
            </form>
        </main>
    </body>
  </html>