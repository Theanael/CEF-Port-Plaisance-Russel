<!DOCTYPE html>
<html>
    <head>
        <title>Liste des Utilisateurs</title>
        <link rel='stylesheet' href='/css/style.css' />
    </head>
    <body>
        <header>
            <h1>Port de Plaisance Russel</h1>
            <a href="/">Retour</a>
        </header>
        <main>
            <h2>Liste des Utilisateurs</h2>
            <table>
                <thead>
                    <tr>
                        <th>Nom d'Utilisateur</th>
                        <th>E-Mail</th>
                    </tr>
                </thead>
                <tbody>
                   <% users.forEach(user => { %>
                    <%- include('line',{user:user}) %>
                   <% }) %>
                    <tr>
                        <td>
                            <a href="./create">Créer un utilisateur</a>
                        </td>
                    </tr>
                </tbody>
                    
            </table>
        </main>
    </body>
  </html>